# Server Configuration
PORT=5001
# Set to 1 behind a single reverse proxy such as Render
TRUST_PROXY=1
# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:5173,https://precise-hire-tau.vercel.app

# AWS S3 and DynamoDB Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
DYNAMODB_TABLE_JOBS=precisehire_jobs
DYNAMODB_TABLE_CANDIDATES=precisehire_candidates

# Email Service (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# LLM Provider Configuration (OpenAI-compatible, e.g. Groq, NVIDIA NIM, OpenAI, Ollama)
# Legacy NVIDIA_* environment variables still work as fallbacks if LLM_* variables are not set.
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Per-call LLM request timeout in milliseconds (between 5000 and 300000, default 90000)
LLM_TIMEOUT_MS=90000
# Optional reasoning effort for models supporting it (low | medium | high)
LLM_REASONING_EFFORT=medium

# Legacy NVIDIA Configuration (still supported as fallbacks)
# NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_PRIMARY_MODEL=meta/llama-3.2-11b-vision-instruct
# NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b
# NVIDIA_TIMEOUT_MS=90000

# Upload Limits
UPLOAD_MAX_ROWS=1000

# Bulk Email Configuration
# Organization name used in bulk email subjects, bodies, and signatures (default "the hiring team")
COMPANY_NAME=PreciseHire
# Delay in milliseconds between consecutive bulk email sends (minimum 200, default 1100)
EMAIL_SEND_DELAY_MS=1100
# Maximum recipients permitted per bulk email send request (default 200)
EMAIL_BULK_MAX=200
# When set to true, simulates bulk email sending without delivering emails or updating DB
EMAIL_DRY_RUN=false
