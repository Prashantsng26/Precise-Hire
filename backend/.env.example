# Server Configuration
PORT=5001

# AWS S3 and DynamoDB Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
DYNAMODB_TABLE_JOBS=precisehire_jobs
DYNAMODB_TABLE_CANDIDATES=precisehire_candidates

# Email Service (Gmail SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# NVIDIA NIM / LLM Configuration (models get retired: verify with GET /v1/models plus a test call)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_PRIMARY_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b
# Per-call LLM request timeout in milliseconds (between 5000 and 300000)
NVIDIA_TIMEOUT_MS=90000

# Upload Limits
UPLOAD_MAX_ROWS=1000
